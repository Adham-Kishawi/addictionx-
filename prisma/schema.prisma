// Prisma Schema — Luxury Perfume E-commerce (Egypt, EGP)
// Rule of thumb: all amounts are Int in piasters (100 piasters = 1 EGP). Never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth.js (Prisma Adapter)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  role          Role      @default(CUSTOMER)
  // Empty array = full (super) admin access. Non-empty = limited to these.
  permissions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  newsletterEntries NewsletterEntry[]
  passwordHash      String?
  verifiedPayments  PaymentProof[] @relation("PaymentVerifier")

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// Catalog
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Product {
  id            String   @id @default(cuid())
  name          String
  nameEn        String?
  slug          String   @unique
  description   String?
  descriptionEn String?
  shortDesc     String?
  brandId       String?
  categoryId    String?
  gender        Gender   @default(UNISEX)
  // Collection (rush / noir / gold)
  collection    String?
  // Notes { top, heart, base } — arrays of strings
  notes         Json?
  // Art color gradient { from, to, glow }
  art           Json?
  rating        Float    @default(0)
  reviewsCount  Int      @default(0)
  // Base price in piasters — the actual price is derived per size
  basePrice     Int
  // Price before discount (for the sale badge) — null means no discount
  compareAtPrice Int?
  // Stock for products WITHOUT variants (they have no size rows). Ignored when
  // the product has variants — their per-variant stock is the source of truth.
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  isBestSeller  Boolean  @default(false)
  // Manual ordering within the homepage Best Sellers section (admin reorders it)
  bestsellerOrder Int @default(0)
  isNew         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brand        Brand?           @relation(fields: [brandId], references: [id])
  category     Category?        @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  orderItems   OrderItem[]
  homeSlides   HomeSlide[]
  collectionLinks CollectionProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  // Cloudinary public_id + secure URL
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Uploaded binary images (admin dashboard) — stored in the DB itself so they
// survive serverless deployments (the runtime filesystem is read-only/ephemeral).
// The public URL is /api/uploads/<id>; a route handler streams these bytes back.
model UploadedImage {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  // Private images (e.g. customer avatars) are only served to their owner.
  isPrivate Boolean  @default(false)
  ownerId   String?
  createdAt DateTime @default(now())

  @@map("uploaded_images")
}

// ============================================================
// Home slider slides — dashboard-controlled (admin → Slider).
// Each slide points at a product from the catalog and may override
// its image with a custom one (UploadedImage URL or any URL). The
// storefront shows active slides in `position` order; when no
// slides are configured it falls back to the collection carousel.
// ============================================================
model HomeSlide {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Custom slide image — overrides the product's own image on the slide
  image     String?
  // Admin-set framing for the slide image { x, y, zoom } — applied as
  // object-position + cover scale so wide banners fill the slide card.
  imageAdjust Json?
  // Slide caption overrides (AR/EN) — falls back to product/collection text
  captionAr String?
  captionEn String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("home_slides")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  // Size in ml — e.g. 50ml / 100ml
  sizeMl    Int
  // Actual price in piasters
  price     Int
  stock     Int      @default(0)
  sku       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, sizeMl])
  @@index([productId])
  @@map("product_variants")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1..5
  title     String?
  content   String?
  isApproved Boolean @default(false)
  isHidden   Boolean @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, isApproved])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================================
// Orders
// ============================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  INSTAPAY
  VODAFONE_CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  // Customer contact email captured at checkout. Guests don't have an account,
  // so this is what all customer-facing notifications are sent to. Falls back
  // to the account email (user.email) for signed-in shoppers.
  customerEmail String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  // Server-tracked payment lifecycle — never set from the client. COD orders
  // start PENDING (to be collected on delivery); online payments are verified
  // by the gateway/webhook and the admin. See the Transaction model below.
  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  // Client-generated key that makes order creation idempotent: re-submitting
  // the same checkout (double click / retry / second tab) reuses the existing
  // order instead of placing a duplicate. Stored as @unique to enforce it.
  idempotencyKey String?      @unique
  subtotal      Int // in piasters
  shippingFee   Int
  discount      Int         @default(0)
  total         Int // in piasters
  couponCode    String?
  notes         String?
  addressId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  address     Address?    @relation(fields: [addressId], references: [id])
  items       OrderItem[]
  shipment    Shipment?
  transactions Transaction[]
  paymentProofs PaymentProof[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  // Order-time snapshot — price/name are unaffected by later catalog edits
  productName String
  sizeMl      Int?
  unitPrice   Int // in piasters
  quantity    Int
  lineTotal   Int // in piasters

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Shipment {
  id          String      @id @default(cuid())
  orderId     String      @unique
  carrier     String
  trackingNumber String?
  status      String      @default("CREATED")
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model PaymentProof {
  id             String   @id @default(cuid())
  orderId        String
  // Receipt image URL (from UploadedImage or external storage)
  receiptUrl     String?
  // Transaction reference number (optional - user can enter it manually)
  transactionRef String?
  // Payment method used (INSTAPAY or VODAFONE_CASH)
  paymentMethod  PaymentMethod
  // Verification status
  status         String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  // Admin who verified/rejected
  verifiedBy     String?
  verifiedAt     DateTime?
  // Rejection reason (if rejected)
  rejectionNote  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifier   User?  @relation("PaymentVerifier", fields: [verifiedBy], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("payment_proofs")
}

model Transaction {
  id        String   @id @default(cuid())
  orderId   String
  provider  String // paymob / fawry / vodafone cash
  reference String?
  amount    Int // in piasters
  status    String   @default("PENDING")
  raw       Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("transactions")
}

// ============================================================
// Store settings (shipping ...)
// ============================================================

model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

// ============================================================
// Addresses and coupons
// ============================================================

model Address {
  id          String   @id @default(cuid())
  // Null for guest checkout orders — the order keeps the address row so the
  // shipping details survive without forcing the customer to create an account.
  userId      String?
  fullName    String
  phone       String
  governorate String
  city        String
  district    String?
  street      String
  building    String?
  apartment   String?
  landmark    String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  DiscountType
  discountValue Int // percentage or amount in piasters depending on type
  minOrderAmount Int?     @default(0)
  maxDiscount   Int?
  maxUses       Int?
  usedCount     Int       @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@map("coupons")
}

enum DiscountType {
  PERCENT
  FIXED
}

// ============================================================
// Collections — managed from the dashboard
// Product.collection is a string slug pointing to these tables
// (no intrusive FK — so places reading the slug directly don't break)
// ============================================================

model Collection {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  // Representative image — shown on the home slider and the collections hub
  // (an UploadedImage URL like /api/uploads/<id>, or any absolute URL)
  image        String?
  // Admin-set framing for the image inside its display boxes { x, y, zoom } —
  // x/y = object-position %, zoom = cover scale. Fixes ugly center-crops.
  imageAdjust  Json?
  // Slider / collection caption (dashboard-controlled, AR + EN)
  descriptionAr String?
  descriptionEn String?
  sortOrder   Int      @default(0)
  // Show the collection in the home "Our Collections" section — independent
  // from isActive (which hides it from the site entirely).
  showInHome  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productLinks CollectionProduct[]

  @@map("collections")
}

// ============================================================
// Collection ↔ Product membership (many-to-many, prepared but not yet wired
// into the product form / storefront). Today membership is decided by the
// single optional Product.collection slug; this join table lets a product sit
// in several collections at once. Each product still keeps its legacy slug
// column (nullable) so existing readers keep working during the migration.
// ============================================================

model CollectionProduct {
  id           String     @id @default(cuid())
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([collectionId])
  @@map("collection_products")
}

// ============================================================
// Shipping zones — governorate → regions, each with its own fee.
// Checkout picks a governorate + region; the fee is read from the
// Region row server-side (never trusted from the client). The flat
// shipping_fee setting is only a fallback when no zones exist.
// ============================================================

model Governorate {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions Region[]

  @@index([isActive])
  @@map("governorates")
}

model Region {
  id            String      @id @default(cuid())
  governorateId String
  nameAr        String
  nameEn        String
  // Delivery fee for this region, in piasters
  shippingFee   Int
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Cascade)

  @@index([governorateId, isActive])
  @@map("regions")
}

// ============================================================
// Newsletter
// ============================================================

model NewsletterEntry {
  id              String   @id @default(cuid())
  email           String   @unique
  userId          String?
  isActive        Boolean  @default(true)
  unsubscribeToken String? @unique
  createdAt       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("newsletter_entries")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}
