# Cache policy for static assets served by Workers Assets.
# Next static chunks are content-hashed: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Committed media assets change only via deploy: long browser cache + edge cache.
/hero/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/slider/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/shelf/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/collections/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/uploads/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/360/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
